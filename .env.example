# Leave ANTHROPIC_API_KEY unset to run entirely in mock mode (replayed LLM responses).
# Set it to switch the same graph onto live Claude calls.
ANTHROPIC_API_KEY=

# auto | mock | live   (auto = live when a key is present, otherwise mock)
DOC_EVAL_MODE=auto

# Any current Claude model id. Pricing for unlisted ids falls back to the Opus tier.
DOC_EVAL_MODEL=claude-opus-5

# Guardrail budget ceilings.
DOC_EVAL_MAX_ITERATIONS=12
DOC_EVAL_MAX_TOKENS=200000
DOC_EVAL_MAX_WALL_SECONDS=300

# Hosts the Fetcher may reach without escalating the call's risk tier.
DOC_EVAL_ALLOWED_HOSTS=raw.githubusercontent.com,petstore3.swagger.io,api.github.com

# Optional: mirror the run ledger into AgentOps. Never required.
AGENTOPS_API_KEY=
