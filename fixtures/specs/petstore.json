{
  "openapi": "3.0.3",
  "info": {
    "title": "Petstore API",
    "version": "1.4.0",
    "description": "A small, reasonably well documented API. Used as the high-scoring fixture."
  },
  "servers": [{ "url": "https://api.petstore.example.com/v1" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "description": "Returns a paginated list of pets visible to the caller. Results are ordered by creation time, newest first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of pets to return. Defaults to 20, capped at 100.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of pets.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } },
                "example": [{ "id": 1, "name": "Fido", "status": "available" }]
              }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": {
            "description": "Rate limit exceeded. Retry after the interval in the Retry-After header.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "description": "Registers a new pet. The name must be unique within the owning account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPet" },
              "example": { "name": "Rex", "status": "available" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The pet was created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "400": {
            "description": "The request body failed validation.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "409": {
            "description": "A pet with that name already exists in this account.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "summary": "Fetch one pet",
        "description": "Returns a single pet by its identifier.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "The pet's server-assigned identifier.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested pet.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "404": {
            "description": "No pet with that identifier is visible to the caller.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"],
            "default": "available"
          }
        }
      },
      "NewPet": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"],
            "default": "available"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
